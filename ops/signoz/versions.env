# SigNoz deployment pin for this repository. Dashboards and signal references are
# validated against these versions. Upgrade deliberately: change this file, re-run
# query validation for every dashboard, and record the change in the commit.

# Git tag of https://github.com/SigNoz/signoz whose deploy/docker files are used.
SIGNOZ_DEPLOY_REF=v0.128.0

# Image tags read by the official deploy/docker/docker-compose.yaml.
VERSION=v0.128.0
OTELCOL_TAG=v0.144.5

# Images fixed by that compose file at SIGNOZ_DEPLOY_REF, recorded for verification.
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.5.6
ZOOKEEPER_IMAGE=signoz/zookeeper:3.7.1

# OTLP generator for synthetic ingestion checks.
TELEMETRYGEN_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.144.0
